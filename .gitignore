# ==============================================================================
# ExtensionFlow - Comprehensive Monorepo .gitignore
# Covers Dependencies, Caches, Test Fixtures, Editor configs, Build, and OS files
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies, Local Caches & Workspace Overrides
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.cache/
**/.cache/
fixtures/
**/fixtures/
.vscode/
**/.vscode/

# Package managers
.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ------------------------------------------------------------------------------
# 2. Browser Binaries, Profiles & Runtime Caches (Chrome for Testing & Puppeteer)
# ------------------------------------------------------------------------------
profiles/
**/profiles/
default-profile/
**/default-profile/
DevToolsActivePort
**/.local-chromium/

# ------------------------------------------------------------------------------
# 3. Build & Compiler Artifacts (TypeScript, esbuild, VS Code Extension)
# ------------------------------------------------------------------------------
dist/
**/dist/
/out/
/build/
*.vsix
**/*.vsix
*.tsbuildinfo
**/*.tsbuildinfo
tsconfig.tsbuildinfo
packages/*/tsconfig.tsbuildinfo

# Ensure source files are never ignored even if nested in build-named folders
!**/src/**

# Build-time synced helper assets (auto-copied during build from packages/helper-extension)
packages/vscode/helper-extension/

# ------------------------------------------------------------------------------
# 4. Logs, PIDs & Debugging Output
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 5. Testing, Code Coverage & VS Code Sandbox
# ------------------------------------------------------------------------------
coverage/
**/coverage/
*.lcov
.nyc_output
.vitest/
test-results/
.vscode-test/
.vscode-test-web/

# ------------------------------------------------------------------------------
# 6. Environment Variables, Certificates & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.crt

# ------------------------------------------------------------------------------
# 7. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 8. Editor & IDE Settings
# ------------------------------------------------------------------------------
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# ------------------------------------------------------------------------------
# 9. Temporary & Scratch Files
# ------------------------------------------------------------------------------
tmp/
**/tmp/
temp/
**/temp/
scratch/
**/scratch/
